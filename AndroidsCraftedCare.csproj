<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AndroidsCraftedCare</AssemblyName>
    <RootNamespace>AndroidsCraftedCare</RootNamespace>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">/root/rimworld_libs</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(GameManagedDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="RimWorld"><HintPath>$(GameManagedDir)/RimWorld.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameManagedDir)/UnityStubs.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CraftedCareMain.cs" />
    <Compile Include="CraftedCareMechanicalProperties.cs" />
    <Compile Include="WorkGiver_TendAndroid.cs" />
    <Compile Include="HarmonyPatches.cs" />
  </ItemGroup>
</Project>
