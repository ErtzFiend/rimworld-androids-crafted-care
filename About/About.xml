<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Androids: Crafted Care</name>
  <author>jacob</author>
  <packageId>jacob.androidscraftedcare</packageId>
  <description>Crafted androids are tended through the Crafting work type instead of Medical. They still use medical beds and the Androids mod's own repair parts. Organic tending is unchanged.</description>
